<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="8.9.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.7" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.SqlServer.DacFx" Version="170.3.93" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.11.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MCPRegistry\MCPRegistry.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <MCPRegistryDatabaseProject>$(MSBuildThisFileDirectory)..\MCPRegistryDatabase\MCPRegistryDatabase.sqlproj</MCPRegistryDatabaseProject>
    <MCPRegistryDacpacPath>$(MSBuildThisFileDirectory)..\MCPRegistryDatabase\bin\$(Configuration)\MCPRegistryDatabase.dacpac</MCPRegistryDacpacPath>
  </PropertyGroup>

  <!--
    The SQL project targets net framework which is incompatible with this net10.0 test project.
    Invoke MSBuild directly to produce the dacpac, then copy it to
    the test output so the WebApplicationFactory can locate it next to the test assembly.
  -->
  <Target Name="BuildMCPRegistryDacpac" BeforeTargets="BeforeBuild">
    <MSBuild Projects="$(MCPRegistryDatabaseProject)"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier"
             Targets="Restore;Build" />
  </Target>

  <Target Name="CopyMCPRegistryDacpac"
          AfterTargets="Build"
          Inputs="$(MCPRegistryDacpacPath)"
          Outputs="$(OutputPath)MCPRegistryDatabase.dacpac">
    <Copy SourceFiles="$(MCPRegistryDacpacPath)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
